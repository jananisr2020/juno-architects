# Frontend build variables (all VITE_* values are public in the browser bundle)
SITE_URL=https://your-final-site.example
VITE_API_BASE_URL=https://your-api.example

# API service variables — set only in the API hosting environment, never in Netlify frontend variables
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
REVIEW_ADMIN_TOKEN=replace-with-a-separate-random-reviewer-secret
FRONTEND_ORIGINS=https://your-final-site.example
